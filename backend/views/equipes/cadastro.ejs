<%- include('../parciais/cabecalho.ejs', { titulo: 'Nova equipe | VoleiStats' }) %>
<%- include('../parciais/menu_lateral.ejs') %>

<main class="conteudo-principal">
  <header class="barra-superior">
    <div>
      <p class="texto-pequeno">ORGANIZAÇÃO DO ELENCO</p>
      <h1>Nova equipe</h1>
      <p class="subtitulo">Cadastre uma equipe para organizar atletas e partidas.</p>
    </div>
  </header>

  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="aviso erro" role="alert"><%= erro %></div>
  <% } %>

  <section class="secao">
    <form class="grade-formulario" action="/equipes" method="post">
      <div class="campo completo">
        <label for="nome-equipe">Nome da equipe</label>
        <input id="nome-equipe" name="nome" type="text" placeholder="Ex.: Volei Clube" required>
      </div>

      <div class="campo">
        <label for="categoria-equipe">Categoria</label>
        <input id="categoria-equipe" name="categoria" type="text" placeholder="Ex.: Adulto feminino" required>
      </div>

      <div class="campo">
        <label for="local-equipe">Local de treino</label>
        <input id="local-equipe" name="local" type="text" placeholder="Ex.: Ginásio municipal" required>
      </div>

      <div class="campo completo">
        <label for="descricao-equipe">Descrição</label>
        <textarea id="descricao-equipe" name="descricao" placeholder="Informações adicionais sobre a equipe"></textarea>
      </div>

      <div class="acoes-formulario">
        <a href="/equipes" class="botao secundario">Cancelar</a>
        <button type="submit" class="botao principal">Criar equipe</button>
      </div>
    </form>
  </section>
</main>

<%- include('../parciais/rodape.ejs') %>