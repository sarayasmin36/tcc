<%- include('../parciais/cabecalho.ejs', { titulo: 'Criar conta | VoleiStats' }) %>
<%- include('../parciais/menu_lateral.ejs') %>

<main class="conteudo-principal">
    <header class="barra-superior">
        <div>
            <p class="texto-pequeno">CONTA DA ATLETA</p>
            <h1>Criar conta</h1>
            <p class="subtitulo">
                Cadastre o e-mail e a senha da atleta.
            </p>
        </div>
    </header>

    <section class="secao">
        <form action="/atletas/<%= atleta.id_atleta %>/criar-conta" method="post">
            <div class="campo">
                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" required>
            </div>

            <div class="campo">
                <label for="senha">Senha</label>
                <input id="senha" name="senha" type="password" minlength="6" required>
            </div>

            <button type="submit" class="botao principal">
                Criar conta
            </button>
        </form>
    </section>
</main>

<%- include('../parciais/rodape.ejs') %>
