<%- include('../parciais/cabecalho.ejs', { titulo: 'Atletas | VoleiStats' }) %>
<%- include('../parciais/menu_lateral.ejs') %>

<main class="conteudo-principal">
  <header class="barra-superior">
    <div>
      <p class="texto-pequeno">ELENCO</p>
      <h1>Atletas</h1>
      <p class="subtitulo">Consulte os atletas vinculados às suas equipes.</p>
    </div>

    <div class="acoes-superiores">
      <label class="campo campo-busca" for="busca-atletas">
        <span class="texto-oculto">Buscar atleta</span>
        <input id="busca-atletas" type="search" placeholder="Buscar atleta..." data-filtro-atletas>
      </label>

      <a href="/registro-atleta" class="botao principal">Novo atleta</a>
    </div>
  </header>

  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="aviso erro" role="alert"><%= erro %></div>
  <% } %>

  <section class="secao">
    <div class="cabecalho-secao">
      <div>
        <h2>Atletas cadastrados</h2>
        <p class="subtitulo">Filtre por nome ou equipe.</p>
      </div>

      <label class="campo" for="filtro-equipe-atletas">
        <span>Equipe</span>
        <select id="filtro-equipe-atletas" data-filtro-equipe>
          <option value="">Todas as equipes</option>
          <% if (Array.isArray(equipes)) { %>
            <% equipes.forEach(function(equipe) { %>
              <option value="<%= equipe.id_equipe || equipe.id %>"><%= equipe.nome %></option>
            <% }); %>
          <% } %>
        </select>
      </label>
    </div>

    <% if (Array.isArray(atletas) && atletas.length > 0) { %>
      <div class="envoltorio-tabela">
        <table class="tabela tabela-atletas">
          <thead>
            <tr>
              <th>Atleta</th>
              <th>Posição</th>
              <th>Equipe</th>
              <th>Camisa</th>
              <th>Ações</th>
            </tr>
          </thead>

          <tbody id="lista-atletas">
            <% atletas.forEach(function(atleta) { %>
              <% const idAtleta = atleta.id_atleta || atleta.id || ''; %>
              <% const idEquipe = atleta.id_equipe || atleta.equipe_id || atleta.equipeId || ''; %>
              <% const nomeEquipe = atleta.nome_equipe || atleta.equipe_nome || atleta.equipeNome || 'Sem equipe'; %>
              <% const numeroCamisa = atleta.numero_camisa || atleta.numeroCamisa || atleta.membro_numero_camisa || 'Não definida'; %>

              <tr data-linha-atleta data-nome-atleta="<%= atleta.nome || '' %>" data-equipe-atleta="<%= idEquipe %>">
                <td>
                  <strong><%= atleta.nome || 'Atleta sem nome' %></strong>
                  <% if (atleta.email) { %><span class="texto-secundario"><%= atleta.email %></span><% } %>
                </td>
                <td><%= atleta.posicao || 'Não informada' %></td>
                <td><%= nomeEquipe %></td>
                <td><%= numeroCamisa %></td>
                <td class="acoes-tabela"><a href="/atletas/<%= idAtleta %>" class="botao secundario">Ver detalhes</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="estado-vazio" id="estado-vazio-atletas">
        <h3>Nenhum atleta cadastrado</h3>
        <p class="texto-secundario">Quando você cadastrar um atleta, ele aparecerá nesta lista.</p>
        <a href="/registro-atleta" class="botao principal">Cadastrar atleta</a>
      </div>
    <% } %>
  </section>
</main>

<%- include('../parciais/rodape.ejs') %>