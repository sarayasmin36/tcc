<%- include('parciais/cabecalho.ejs', { titulo: 'Relatórios | VoleiStats' }) %>
    <%- include('parciais/menu_lateral.ejs') %>

        <main class="conteudo-principal">
            <header class="barra-superior">
                <div>
                    <h1>Relatórios</h1>
                    <p class="subtitulo">Analise a evolução e o desempenho da sua equipe.</p>
                </div>

                <div class="acoes-superiores">
                    <button type="button" class="botao secundario botao-bloqueado" disabled
                        title="Disponível após o registro de desempenhos">
                        Exportação em desenvolvimento
                    </button>

                </div>
            </header>

            <section class="grade metricas">
                <article class="cartao">
                    <span class="rotulo-metrica">Aproveitamento geral</span>
                    <strong class="valor-metrica">—</strong>
                    <span class="observacao-metrica">Aguardando partidas</span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">Ataques positivos</span>
                    <strong class="valor-metrica">—</strong>
                    <span class="observacao-metrica">Nenhum dado registrado</span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">Recepções positivas</span>
                    <strong class="valor-metrica">—</strong>
                    <span class="observacao-metrica">Nenhum dado registrado</span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">Erros por set</span>
                    <strong class="valor-metrica">—</strong>
                    <span class="observacao-metrica">Nenhum dado registrado</span>
                </article>
            </section>

            <section class="grade duas-colunas">
                <article class="cartao">
                    <div class="cabecalho-secao">
                        <div>
                            <h2>Aproveitamento por fundamento</h2>
                            <p class="subtitulo">Resumo dos principais fundamentos.</p>
                        </div>
                    </div>

                    <div class="lista-indicadores" id="lista-indicadores">
                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Ataque</span>
                                <strong>—</strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: 0%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Bloqueio</span>
                                <strong>—</strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: 0%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Saque</span>
                                <strong>—</strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: 0%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Recepção</span>
                                <strong>—</strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: 0%"></span>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="cartao">
                    <div class="cabecalho-secao">
                        <div>
                            <h2>Desempenho por set</h2>
                            <p class="subtitulo">Comparação dos sets registrados.</p>
                        </div>
                    </div>

                    <div class="grafico" id="grafico-sets" data-grafico-sets>
                        <div class="coluna" style="height: 0%" data-set="1">
                            <span class="valor-coluna">—</span>
                            <small>Set 1</small>
                        </div>

                        <div class="coluna" style="height: 0%" data-set="2">
                            <span class="valor-coluna">—</span>
                            <small>Set 2</small>
                        </div>

                        <div class="coluna" style="height: 0%" data-set="3">
                            <span class="valor-coluna">—</span>
                            <small>Set 3</small>
                        </div>

                        <div class="coluna" style="height: 0%" data-set="4">
                            <span class="valor-coluna">—</span>
                            <small>Set 4</small>
                        </div>
                    </div>

                </article>
            </section>

            <section class="secao">
                <div class="cabecalho-secao">
                    <div>
                        <h2>Atletas em destaque</h2>
                        <p class="subtitulo">Os melhores desempenhos aparecerão aqui.</p>
                    </div>
                </div>

                <div class="estado-vazio">
                    <h3>Ainda não há desempenho para analisar</h3>
                    <p class="texto-secundario">
                        Registre uma partida e lance os fundamentos de cada atleta para gerar relatórios.
                    </p>
                    <% if (usuario && usuario.tipo_usuario === 'TREINADOR') { %>
    <a href="/partidas/cadastro" class="botao principal">
        Registrar partida
    </a>
<% } %>
                </div>
            </section>
        </main>

        <%- include('parciais/rodape.ejs') %>