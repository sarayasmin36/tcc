<%- include('parciais/cabecalho.ejs', { titulo: 'Relatórios | VoleiStats' }) %>
    <%- include('parciais/menu_lateral.ejs') %>

        <%
            const listaRelatorios =
                typeof relatorios !== 'undefined' && Array.isArray(relatorios)
                    ? relatorios
                    : [];

            const soma = (campo) => listaRelatorios.reduce(
                (total, item) => total + Number(item[campo] || 0),
                0
            );

            const ataquesCertos = soma('ataques_certos');
            const ataquesErrados = soma('ataques_errados');
            const recepcoesCertas = soma('recepcoes_certas');
            const recepcoesErradas = soma('recepcoes_erradas');
            const bloqueiosCertos = soma('bloqueios_certos');
            const bloqueiosErrados = soma('bloqueios_errados');
            const saquesCertos = soma('saques_certos');
            const saquesErrados = soma('saques_errados');

            const totalAtaques = ataquesCertos + ataquesErrados;
            const totalRecepcoes = recepcoesCertas + recepcoesErradas;
            const totalBloqueios = bloqueiosCertos + bloqueiosErrados;
            const totalSaques = saquesCertos + saquesErrados;
            const totalErros = ataquesErrados + recepcoesErradas
                + bloqueiosErrados + saquesErrados;

            const percentual = (certos, total) => total > 0
                ? Math.round((certos / total) * 100)
                : 0;
        %>

        <main class="conteudo-principal">
            <header class="barra-superior">
                <div>
                    <h1>Relatórios</h1>
                    <p class="subtitulo">
                        Analise a evolução e o desempenho da sua equipe.
                    </p>
                </div>

                <div class="acoes-superiores">
                    <button
                        type="button"
                        class="botao secundario botao-bloqueado"
                        disabled
                        title="Disponível após o registro de desempenhos">
                        Exportação em desenvolvimento
                    </button>
                </div>
            </header>

            <section class="grade metricas">
                <article class="cartao">
                    <span class="rotulo-metrica">
                        Aproveitamento geral
                    </span>
                    <strong class="valor-metrica">
                        <%= listaRelatorios.length %>
                    </strong>
                    <span class="observacao-metrica">
                        Atletas com dados registrados
                    </span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">
                        Ataques positivos
                    </span>
                    <strong class="valor-metrica">
                        <%= percentual(ataquesCertos, totalAtaques) %>%
                    </strong>
                    <span class="observacao-metrica">
                        <%= ataquesCertos %> ataques certos
                    </span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">
                        Recepções positivas
                    </span>
                    <strong class="valor-metrica">
                        <%= percentual(recepcoesCertas, totalRecepcoes) %>%
                    </strong>
                    <span class="observacao-metrica">
                        <%= recepcoesCertas %> recepções certas
                    </span>
                </article>

                <article class="cartao">
                    <span class="rotulo-metrica">
                        Erros por set
                    </span>
                    <strong class="valor-metrica">
                        <%= totalErros %>
                    </strong>
                    <span class="observacao-metrica">
                        Erros registrados
                    </span>
                </article>
            </section>

            <section class="grade duas-colunas">
                <article class="cartao">
                    <div class="cabecalho-secao">
                        <div>
                            <h2>Aproveitamento por fundamento</h2>
                            <p class="subtitulo">
                                Resumo dos principais fundamentos.
                            </p>
                        </div>
                    </div>

                    <div class="lista-indicadores" id="lista-indicadores">
                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Ataque</span>
                                <strong>
                                    <%= percentual(ataquesCertos, totalAtaques) %>%
                                </strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: <%= percentual(ataquesCertos, totalAtaques) %>%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Bloqueio</span>
                                <strong>
                                    <%= percentual(bloqueiosCertos, totalBloqueios) %>%
                                </strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: <%= percentual(bloqueiosCertos, totalBloqueios) %>%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Saque</span>
                                <strong>
                                    <%= percentual(saquesCertos, totalSaques) %>%
                                </strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: <%= percentual(saquesCertos, totalSaques) %>%"></span>
                            </div>
                        </div>

                        <div class="indicador">
                            <div class="cabecalho-indicador">
                                <span>Recepção</span>
                                <strong>
                                    <%= percentual(recepcoesCertas, totalRecepcoes) %>%
                                </strong>
                            </div>
                            <div class="barra-indicador">
                                <span style="width: <%= percentual(recepcoesCertas, totalRecepcoes) %>%"></span>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="cartao">
                    <div class="cabecalho-secao">
                        <div>
                            <h2>Desempenho por set</h2>
                            <p class="subtitulo">
                                Comparação dos sets registrados.
                            </p>
                        </div>
                    </div>

                    <div
                        class="grafico"
                        id="grafico-sets"
                        data-grafico-sets>
                        <div
                            class="coluna"
                            style="height: 0%"
                            data-set="1">
                            <span class="valor-coluna">—</span>
                            <small>Set 1</small>
                        </div>

                        <div
                            class="coluna"
                            style="height: 0%"
                            data-set="2">
                            <span class="valor-coluna">—</span>
                            <small>Set 2</small>
                        </div>

                        <div
                            class="coluna"
                            style="height: 0%"
                            data-set="3">
                            <span class="valor-coluna">—</span>
                            <small>Set 3</small>
                        </div>

                        <div
                            class="coluna"
                            style="height: 0%"
                            data-set="4">
                            <span class="valor-coluna">—</span>
                            <small>Set 4</small>
                        </div>
                    </div>
                </article>
            </section>

            <section class="secao">
                <div class="cabecalho-secao">
                    <div>
                        <h2>Atletas em destaque</h2>
                        <p class="subtitulo">
                            Os melhores desempenhos aparecerão aqui.
                        </p>
                    </div>
                </div>

                <% if (listaRelatorios.length === 0) { %>
                    <div class="estado-vazio">
                        <h3>Ainda não há desempenho para analisar</h3>
                        <p class="texto-secundario">
                            Registre uma partida e lance os fundamentos de cada atleta para gerar relatórios.
                        </p>

                        <% if (usuario && usuario.tipo_usuario === 'TREINADOR') { %>
                            <a
                                href="/partidas/cadastro"
                                class="botao principal">
                                Registrar partida
                            </a>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="envoltorio-tabela">
                        <table>
                            <thead>
                                <tr>
                                    <th>Atleta</th>
                                    <th>Equipe</th>
                                    <th>Partidas</th>
                                    <th>Ataques certos</th>
                                    <th>Levantamentos certos</th>
                                    <th>Saques certos</th>
                                    <th>Bloqueios certos</th>
                                    <th>Recepções certas</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% listaRelatorios.forEach((relatorio) => { %>
                                    <tr>
                                        <td>
                                            <strong>
                                                <%= relatorio.nome_atleta %>
                                            </strong>
                                        </td>
                                        <td><%= relatorio.nome_equipe %></td>
                                        <td><%= relatorio.total_partidas %></td>
                                        <td><%= relatorio.ataques_certos || 0 %></td>
                                        <td><%= relatorio.levantamentos_certos || 0 %></td>
                                        <td><%= relatorio.saques_certos || 0 %></td>
                                        <td><%= relatorio.bloqueios_certos || 0 %></td>
                                        <td><%= relatorio.recepcoes_certas || 0 %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </main>

        <%- include('parciais/rodape.ejs') %>
