<%- include('../parciais/cabecalho.ejs', { titulo: 'Partidas | VoleiStats' }) %>
<%- include('../parciais/menu_lateral.ejs') %>

<main class="conteudo-principal">
  <header class="barra-superior">
    <div>
      <p class="texto-pequeno">ACOMPANHAMENTO</p>
      <h1>Partidas</h1>
      <p class="subtitulo">Consulte as partidas cadastradas e organize os próximos jogos.</p>
    </div>

    <div class="acoes-superiores">
      <a href="/partidas/cadastro" class="botao principal">Nova partida</a>
    </div>
  </header>

  <section class="secao">
    <div class="cabecalho-secao">
      <div>
        <h2>Partidas cadastradas</h2>
        <p class="subtitulo">Pesquise por equipe, adversário, campeonato ou situação.</p>
      </div>

      <label class="campo campo-busca" for="busca-partidas">
        <span class="texto-oculto">Buscar partida</span>
        <input id="busca-partidas" type="search" placeholder="Buscar partida..." data-filtro-partidas>
      </label>
    </div>

    <div class="lista-partidas" id="lista-partidas">
      <% if (typeof partidas !== 'undefined' && partidas.length > 0) { %>
        <% partidas.forEach(function(partida) { %>
          <% const idPartida = partida.id_partida || partida.id; %>
          <% const nomeAdversario = partida.nome_equipe_adversaria || partida.nomeEquipeAdversaria || partida.adversario || 'Equipe adversária'; %>
          <% const nomeEquipe = partida.nome_equipe || partida.nomeEquipe || 'Minha equipe'; %>
          <% const campeonato = partida.campeonato || 'Sem campeonato informado'; %>
          <% const dataPartida = partida.data_partida || partida.dataPartida || ''; %>
          <% const situacao = partida.status || partida.situacao || 'Agendada'; %>

          <article class="cartao linha-partida" data-partida-busca="<%= nomeEquipe %> <%= nomeAdversario %> <%= campeonato %> <%= situacao %>">
            <div class="identificador-partida"><span>VS</span></div>

            <div class="informacoes-partida">
              <p class="texto-pequeno"><%= campeonato %></p>
              <h3><%= nomeEquipe %> x <%= nomeAdversario %></h3>

              <div class="detalhes-partida">
                <% if (dataPartida) { %><span><%= dataPartida %></span><% } %>
                <% if (partida.hora_partida || partida.horaPartida) { %><span><%= partida.hora_partida || partida.horaPartida %></span><% } %>
                <% if (partida.local) { %><span><%= partida.local %></span><% } %>
              </div>
            </div>

            <span class="etiqueta etiqueta-partida"><%= situacao %></span>

            <div class="acoes-partida">
              <span class="botao secundario botao-bloqueado" title="Módulo em desenvolvimento">Desempenho em desenvolvimento</span>
            </div>
          </article>
        <% }); %>

        <div class="estado-vazio oculto" id="estado-vazio-partidas">
          <h3>Nenhuma partida encontrada</h3>
          <p class="texto-secundario">Tente buscar por outra equipe, campeonato ou situação.</p>
        </div>
      <% } else { %>
        <div class="estado-vazio" id="estado-vazio-partidas">
          <h3>Nenhuma partida cadastrada</h3>
          <p class="texto-secundario">Cadastre uma partida para organizar sua temporada.</p>
          <a href="/partidas/cadastro" class="botao principal">Criar primeira partida</a>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../parciais/rodape.ejs') %>
