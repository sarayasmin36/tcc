<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | VoleiStats</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-logo">🏐</div>
                <div>
                    <div class="brand-name">VoleiStats</div>
                    <div class="brand-sub">Dashboard esportivo</div>
                </div>
            </div>

            <div class="profile-top">
                <div class="avatar">AS</div>
                <div>
                    <div class="profile-name"><%= usuario ? usuario.nome : 'Usuário' %></div>
                    <div class="profile-role"><%= usuario ? usuario.tipo_usuario : 'Visitante' %></div>
                </div>
            </div>

            <nav class="nav">
                <a class="active" href="/">⌂ Início</a>
                <a href="/equipes">◆ Equipes</a>
                <a href="/atletas">● Atletas</a>
                <a href="/campeonatos">★ Campeonatos</a>
                <a href="/partidas">▣ Partidas</a>
                <a href="/relatorios">▤ Relatórios</a>
            </nav>

            <div class="sidebar-foot">
                <a class="btn danger" href="/logout">Sair</a>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div>
                    <h1>Visão geral</h1>
                    <p class="subtitle">Acompanhe sua operação esportiva</p>
                </div>
                <div class="top-actions">
                    <div class="avatar">AS</div>
                </div>
            </header>

            <section class="grid metrics">
                <div class="card">
                    <div class="metric-label">Atletas</div>
                    <div class="metric-value"><%= totalAtletas || 0 %></div>
                    <div class="metric-note">Atletas cadastrados</div>
                </div>

                <div class="card">
                    <div class="metric-label">Equipes</div>
                    <div class="metric-value"><%= totalEquipes || 0 %></div>
                    <div class="metric-note">Equipes ativas</div>
                </div>

                <div class="card">
                    <div class="metric-label">Campeonatos</div>
                    <div class="metric-value"><%= totalCampeonatos || 0 %></div>
                    <div class="metric-note">Temporadas cadastradas</div>
                </div>

                <div class="card">
                    <div class="metric-label">Partidas</div>
                    <div class="metric-value"><%= totalPartidas || 0 %></div>
                    <div class="metric-note">Partidas registradas</div>
                </div>
            </section>

            <section class="grid two">
                <div class="section">
                    <div class="section-head">
                        <h2>Próximas partidas</h2>
                        <a class="btn ghost" href="/partidas">Ver todas</a>
                    </div>

                    <% if (partidas && partidas.length) { %>
                        <% partidas.forEach(partida => { %>
                            <div class="match-row">
                                <div>
                                    <strong><%= partida.equipe_casa %> x <%= partida.equipe_fora %></strong>
                                    <div class="muted"><%= partida.data %> às <%= partida.horario %></div>
                                </div>
                                <span class="badge yellow">Agendada</span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="muted">Nenhuma partida próxima.</p>
                    <% } %>
                </div>

                <div class="section">
                    <div class="section-head">
                        <h2>Minhas equipes</h2>
                        <a class="btn ghost" href="/equipes">Abrir</a>
                    </div>

                    <% if (equipes && equipes.length) { %>
                        <% equipes.forEach(equipe => { %>
                            <div class="team-row">
                                <div>
                                    <strong><%= equipe.nome %></strong>
                                    <div class="muted"><%= equipe.categoria %></div>
                                </div>
                                <span class="badge green"><%= equipe.codigo_convite %></span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="muted">Nenhuma equipe cadastrada.</p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>